# Local development without Docker
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=local-development-key-change-me
ALLOWED_HOSTS_DEV=127.0.0.1,localhost

# Google Gemini / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=ziarama-wedding-akk
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_TEXT_MODEL=gemini-2.5-flash
GOOGLE_VISION_MODEL=gemini-2.5-flash
GOOGLE_EMBEDDING_MODEL=text-embedding-004
GOOGLE_EMBEDDING_NATIVE_DIMENSIONS=768
# Optional when ADC is already configured with gcloud auth application-default login.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json

# OpenAI: python-decouple now reads this correctly from the local .env file.
OPENAI_API_KEY=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
OPENAI_TEXT_MODEL=gpt-5.6
OPENAI_TEXT_MODEL=gpt-5.6
OPENAI_VISION_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Use one stable embedding space. Gemini is ideal when OpenAI is not configured.
AI_EMBEDDING_PROVIDER=gemini
AI_FALLBACK_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_DIMENSIONS=1536
AI_PROVIDER_FAILURE_COOLDOWN_SECONDS=60
AI_VISION_PROVIDER_FAILURE_COOLDOWN_SECONDS=180
AI_PROVIDER_MAX_RETRIES=2
AI_VISION_PROVIDER_MAX_RETRIES=1
AI_PROVIDER_RETRY_BASE_SECONDS=2
AI_PROVIDER_RETRY_MAX_SECONDS=20
AI_ALLOW_DETERMINISTIC_EMBEDDINGS=true

# Advanced panorama vision
VISION_ENABLE_YOLO=true
TOUR_AI_YOLO_MODEL_NAME=yolo11n.pt
TOUR_AI_YOLO_IMAGE_SIZE=896
VISION_ENABLE_PADDLEOCR=true
VISION_ENABLE_FLORENCE2=false
VISION_ENABLE_GEMINI=true
VISION_ENABLE_OPENAI=true
VISION_PRIMARY_SEMANTIC_PROVIDER=gemini
VISION_FALLBACK_SEMANTIC_PROVIDER=openai
VISION_MAX_PANORAMA_FRAMES=12
VISION_SEMANTIC_MAX_FRAMES=12
VISION_SEMANTIC_MAX_CLOUD_CALLS_PER_SCENE=4
VISION_SEMANTIC_REQUEST_INTERVAL_SECONDS=1.25
VISION_PERSPECTIVE_FRAME_SIZE=896
VISION_PADDLEOCR_LANG=en
VISION_LONG_PRESS_DURATION_MS=650
# Exact object hit-testing + targeted fallback when YOLO did not pre-detect the item
VISION_POINT_ON_DEMAND_INSPECTION=true
VISION_POINT_INSPECTION_FOV_DEGREES=46
VISION_POINT_DETAIL_FOV_DEGREES=26
VISION_POINT_INSPECTION_FRAME_SIZE=768
VISION_POINT_PIXEL_PADDING_RATIO=0.012
VISION_POINT_NEAR_PADDING_RATIO=0.035
VISION_POINT_REFINEMENT_AREA_RATIO=0.16
VISION_POINT_REFINE_LOCAL_ONLY=true
VISION_POINT_REFINE_BELOW_CONFIDENCE=0.55
VISION_POINT_SEMANTIC_MIN_CONFIDENCE=0.55
VISION_POINT_SEMANTIC_ONLY_MIN_CONFIDENCE=0.72
VISION_PUBLIC_ON_DEMAND_SCAN=true
VISION_ON_DEMAND_ANALYSIS_MODE=auto
VISION_ON_DEMAND_RETRY_AFTER_MS=3000

# Leave these empty locally; the settings resolve project-relative paths.
TOUR_AI_YOLO_MODEL_PATH=
VISION_YOLO_MODEL=
VISION_LOCAL_THREAD_WORKERS=1
VISION_ANALYSIS_STALE_MINUTES=45
