# Enable this file only after Certbot has issued the certificates.
server {
    listen 443 ssl http2;
    server_name twinscopes.com www.twinscopes.com api.twinscopes.com;
    ssl_certificate /etc/letsencrypt/live/twinscopes.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/twinscopes.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    location /static/ { alias /app/staticfiles/; expires 30d; }
    location /media/ { alias /app/media/; expires 7d; add_header X-Frame-Options SAMEORIGIN always; }
    location /ws/ {
        proxy_pass http://twinscopes_django;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600;
    }
    location / {
        proxy_pass http://twinscopes_django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300;
    }
}
