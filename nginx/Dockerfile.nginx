FROM nginx:1.27-alpine

RUN rm -f /etc/nginx/conf.d/default.conf \
    && sed -E -i 's#(application/javascript[[:space:]]+js)(;)#\1 mjs\2#' /etc/nginx/mime.types \
    && grep -Eq 'application/javascript.*mjs' /etc/nginx/mime.types

COPY nginx.conf /etc/nginx/nginx.conf
COPY conf.d/00-upstreams.conf /etc/nginx/conf.d/00-upstreams.conf
COPY templates /etc/nginx/templates-custom
COPY docker-entrypoint.d/40-configure-tls.sh /docker-entrypoint.d/40-configure-tls.sh

RUN chmod +x /docker-entrypoint.d/40-configure-tls.sh
